# Feste Werte für den Wegwerf-Stack der Handbuch-Aufnahmen (npm run screenshots).
# Alle Passwörter und Schlüssel hier sind TESTWERTE. Sie gelten nur für den kurzlebigen,
# lokalen Stack, der nach jedem Lauf samt Volumes gelöscht wird. Nie für echte Installationen verwenden.
# Ports, Projektname und Image-Tags setzt stack.mjs.

POSTGRES_PASSWORD=handbuch-test-postgres
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=handbuch-test-keycloak
DPP_GATEWAY_CLIENT_SECRET=handbuch-test-dpp-gateway-secret
DPP_POLICY_ADMIN_CLIENT_SECRET=handbuch-test-dpp-policy-secret

# Demo-Konto der fiktiven Organisation "Demo Pumpen GmbH" (Organisationsadministration und Systemverwaltung)
INITIAL_ORGANISATION_ADMIN_EMAIL=alex.muster@demo-pumpen.example
INITIAL_ORGANISATION_ADMIN_VORNAME=Alex
INITIAL_ORGANISATION_ADMIN_NAME=Muster
INITIAL_ORGANISATION_ADMIN_PASSWORD=Handbuch-Demo-2026!

SMTP_SERVER=localhost
SENDER_ADDRESS=noreply@demo-pumpen.example
NEW_ORGA_NOTIFICATION_ADDRESS=admin@demo-pumpen.example
