{
  "name": "aas-suite-documentation",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "docusaurus start --host 0.0.0.0",
    "build": "docusaurus build",
    "build:oss": "DOCS_EDITION=oss docusaurus build --out-dir build-oss",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "check:topics": "node scripts/check-docs-topics.mjs",
    "check:images": "node scripts/check-images.mjs",
    "screenshots": "node scripts/screenshots/run.mjs",
    "screenshots:headed": "HEADED=1 node scripts/screenshots/run.mjs",
    "screenshots:oss": "node scripts/screenshots/run.mjs --oss",
    "screenshots:stack": "node scripts/screenshots/stack.mjs",
    "check:quellen": "node scripts/check-quellen.mjs",
    "pdf": "node scripts/pdf.mjs --build-dir build",
    "pdf:oss": "node scripts/pdf.mjs --build-dir build-oss"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.64.1",
    "js-yaml": "^4.3.2",
    "pagedjs": "^0.4.3",
    "playwright-core": "1.64.1",
    "typescript": "~5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
