{
  "name": "bom-diagram",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/bom-diagram/src",
  "prefix": "vws",
  "projectType": "library",
  "tags": ["scope:shared"],
  "targets": {
    "typecheck": {},
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "vitest.config.mts",
        "coverage": false,
        "watch": false,
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/bom-diagram/**/*.ts", "libs/bom-diagram/**/*.html"]
      }
    }
  }
}
